# ══════════════════════════════════════════════════════════════
# Montréal 2033: Deus Ex Sophia — OpenOSINT Agent Container
# Lightweight, high-performance OSINT reconnaissance daemon
# ══════════════════════════════════════════════════════════════

FROM python:3.11-slim

WORKDIR /app

# Install minimal networking dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    dnsutils \
    && rm -rf /var/lib/apt/lists/*

# Install lightweight Python packages
RUN pip install --no-cache-dir requests

# Copy OpenOSINT API Daemon
COPY docker/openosint_api.py /app/openosint_api.py

# Expose microservice port
EXPOSE 8080

ENV HOST=0.0.0.0
ENV PORT=8080
ENV PYTHONUNBUFFERED=1

HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
  CMD curl -f http://localhost:8080/health || exit 1

# Run the OpenOSINT daemon
CMD ["python", "/app/openosint_api.py"]
